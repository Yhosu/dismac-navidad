                                                },
                                                "participant_link": {
                                                    "type": "string",
                                                    "description": "Enlace web directo para que el participante Ecommerce ingrese a reventar su globo virtual con su carnet."
                                                },
                                                "participant_name": {
                                                    "type": "string",
                                                    "description": "Nombre completo del participante registrado."
                                                },
                                                "participant_email": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Correo electr\u00f3nico del participante (puede ser null)."
                                                },
                                                "participant_ci": {
                                                    "type": "string",
                                                    "description": "Carnet o documento de identidad del participante."
                                                },
                                                "total_attempts": {
                                                    "type": "integer",
                                                    "description": "Cantidad de participaciones disponibles en la promoci\u00f3n Dismac Navidad (formularios en estado \"registered\")."
                                                },
                                                "sphere_color": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Color de la esfera ganada seg\u00fan el rango de compra (Roja, Plateada o Dorada)."
                                                },
                                                "sphere_tier": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Nivel de la esfera ganada (T1, T2 o T3)."
                                                },
                                                "is_ecommerce": {
                                                    "type": "boolean",
                                                    "description": "Indica si la compra corresponde al canal Ecommerce (ECO)."
                                                },
                                                "message_promotion": {
                                                    "type": "string",
                                                    "description": "Mensaje promocional din\u00e1mico informativo indicando el color de esfera ganado e instrucci\u00f3n (globo virtual en Ecommerce o POS f\u00edsico)."
                                                }
                                            },
                                            "required": [
                                                "generate_participant_code",
                                                "participant_link",
                                                "participant_name",
                                                "participant_email",
                                                "participant_ci",
                                                "total_attempts",
                                                "sphere_color",
                                                "sphere_tier",
                                                "is_ecommerce",
                                                "message_promotion"
                                            ]
                                        },
                                        "errors": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
